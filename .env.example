# Copia este archivo como .env y completa solo los proveedores que uses.
# Las claves se leen únicamente en el servidor; nunca se guardan en la base de datos.

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenCode Zen (Big Pickle): https://opencode.ai/docs/zen/
OPENCODE_ZEN_API_KEY=

# Puerto local (solo escucha en 127.0.0.1)
PORT=4317

# Ruta de la base de datos SQLite
DATA_DIR=./data

# Tiempo máximo por llamada a un proveedor en el chat, en milisegundos
PROVIDER_TIMEOUT_MS=120000

# Tiempo máximo por llamada dentro de una tarea (planificar, subtareas, revisión, síntesis).
# Es mayor porque esas respuestas son más largas.
TASK_CALL_TIMEOUT_MS=300000
