{
  "name": "orquestai",
  "version": "0.1.0",
  "private": true,
  "description": "Escritorio personal multiagente de IA para Ingeniería Civil Informática",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"tsx watch src/server/main.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build && tsx src/server/main.ts",
    "serve": "tsx src/server/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "better-sqlite3": "12.11.1",
    "hono": "4.13.13",
    "preact": "10.29.8",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.5",
    "concurrently": "9.2.5",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
